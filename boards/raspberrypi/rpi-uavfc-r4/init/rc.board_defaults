#!/bin/sh
#
# RPI-UAVFC-R4 defaults. Generic quad X airframe so the startup script finds
# an airframe and starts the flight stack. Battery divider from the
# schematic: 22.1 k over 2.2 k. Current scale is for the T-Motor F55A Pro II
# current output (15.2 mV/A); calibrate the current offset for the installed ESC.
# CBRK_SUPPLY_CHK is set: the board cannot measure its 5 V rail. CBRK_USB_CHK
# is 0: the vehicle does not arm with USB connected.
# Missions stay in RAM, as on other FPV boards; the SD card holds logs.
#
#------------------------------------------------------------------------------

param set-default SYS_AUTOSTART 4001
param set-default BAT1_V_DIV 11.045
param set-default BAT1_A_PER_V 65.7895
param set-default CBRK_SUPPLY_CHK 894281
param set-default CBRK_USB_CHK 0
param set-default SYS_HAS_MAG 0
param set-default IMU_GYRO_RATEMAX 400
