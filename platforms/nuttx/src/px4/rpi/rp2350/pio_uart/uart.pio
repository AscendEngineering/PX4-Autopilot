;
; UART PIO programs for the PX4 RP2350 PIO UART serial driver
; (platforms/nuttx/src/px4/rpi/rp2350/pio_uart/pio_uart.c).
;
; From ArduPilot, libraries/AP_HAL_ChibiOS/rp2350/pio/uart.pio. The programs
; are identical to that file at https://github.com/davidbuzz/ardupilot commit
; 426f25a3bb8e8489f185b095d2724d0ca62c8e00. uart_tx is Betaflight's
; src/platform/PICO/uart/uart_tx_program.c, itself derived from pico-examples
; uart_tx.pio. uart_rx is pico-examples uart_rx.pio as Betaflight uses it, and
; uart_rx_sbus is uart_rx with the parity bit skipped. Regenerate uart.pio.h
; with pioasm.sh after editing.
;
; Copyright (c) Betaflight contributors. uart_tx written by Matthew Selby.
; uart_tx and uart_rx are derived from the Raspberry Pi pico-examples:
; Copyright (c) 2020 Raspberry Pi (Trading) Ltd. SPDX-License-Identifier: BSD-3-Clause
;
; This program is free software: you can redistribute it and/or modify it
; under the terms of the GNU General Public License as published by the
; Free Software Foundation, either version 3 of the License, or (at your
; option) any later version.
;
; This program is distributed in the hope that it will be useful, but WITHOUT
; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
; FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for
; more details.
;
; You should have received a copy of the GNU General Public License along
; with this program. If not, see <http://www.gnu.org/licenses/>.
;
; Local modifications (PX4):
;
; - None to the instructions. Only this header is different.
;
; Use in PX4, which is different from the ArduPilot driver:
;
; - The .origin values below are not used. The driver gives each program to
;   the NuttX PIO layer with no fixed origin. NuttX loads the programs from
;   the top of the instruction memory down and adds the load offset to the
;   jump targets. The driver sets the wrap and the start address from that
;   offset. 8 PIO cycles for each bit throughout.
; - uart_rx_sbus is not loaded: the driver does not support parity.
; - The driver is full duplex only. It sets SET_COUNT to 0, thus the two
;   "set pindirs" instructions of uart_tx change no pin and the line is
;   never released.
; - The driver does not use the end-of-transmission flag of uart_tx.
;

; Transmitter, 8N1/8N2. In half duplex the receiver shares the pin, so the
; line is released between frames - but only once nothing more is queued.
; Full duplex sets SET_COUNT to 0, which makes both `set pindirs` no-ops while
; side-set still drives the pin. Y holds the number of extra stop bits. Flag
; sm goes up as the line is released, after the receiver has pushed the last
; byte of our own echo, and the CPU takes it as the end of that echo.
.program uart_tx
.origin 0
.side_set 1 opt
.mov_status txfifo < 1
.wrap_target
tx_release:
    set    pindirs, 0             ; release the line (half duplex only)
tx_await:
    pull   block                  ; idle here
    set    pindirs, 1 side 0  [6] ; take the line AND assert the start bit
    set    x, 7                   ; start bit continues (7 + 1 = 8 cycles)
bitloop:
    out    pins, 1                ; data bit, LSB first
    jmp    x-- bitloop        [6] ; 8 cycles per bit
    jmp    !y, tx_next side 1 [5] ; stop bit 1; y == 0 means one stop bit
    nop                side 1 [7] ; stop bit 2
tx_next:
    mov    x, status              ; X = ~0 iff the TX FIFO is empty
    jmp    !x, tx_await           ; more queued: hold the line, skip the release
    irq    nowait 0 rel           ; nothing queued: end of transmission
.wrap

; Receiver, 8N1/8N2. The stop bit is checked before the byte is pushed. A
; framing error raises flag 4+sm, which the CPU polls (only flags 0-3 reach
; INTE), then waits for an idle line: a line held low would otherwise satisfy
; `wait 0 pin` at once and stream 0x00 at full baud.
.program uart_rx
.origin 11
start:
    wait   0 pin, 0               ; start bit
    set    x, 7               [10] ; delay to the centre of bit 0
bitloop:
    in     pins, 1
    jmp    x-- bitloop        [6]
    jmp    pin, good_stop         ; stop bit high - accept the byte
    irq    nowait 4 rel           ; framing error
    wait   1 pin, 0               ; resync: hold until the line is idle
    jmp    start
good_stop:
    push   block

; SBUS receiver, 8E2. The wire is inverted by GPIO INOVER before it reaches
; the state machine, so the levels here are ordinary UART levels.
.program uart_rx_sbus
.origin 20
start:
    wait   0 pin, 0               ; start bit
    set    x, 7               [10] ; delay to the centre of bit 0
bitloop:
    in     pins, 1
    jmp    x-- bitloop        [6]
    mov    y, y               [6] ; stall through the parity bit
    jmp    pin, good_stop         ; stop bit high - accept the byte
    irq    nowait 4 rel           ; framing error
    wait   1 pin, 0               ; resync: hold until the line is idle
    jmp    start
good_stop:
    push   block
